DirectoryIndex index.php
Options -Indexes
RewriteEngine On
RewriteCond %{HTTP_HOST} ^neksoftconsultancy\.com$ [NC]
RewriteRule ^ https://www.neksoftconsultancy.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_URI} ^/\.(?!well-known/)
RewriteRule ^ - [F,L]
RewriteCond %{REQUEST_URI} !^/(assets|images)/
RewriteRule ^ index.php [L]
<IfModule mod_headers.c>
<FilesMatch "\.(?:js|css|webp|png|jpg|jpeg|woff2?)$">
Header set Cache-Control "public,max-age=604800"
</FilesMatch>
</IfModule>
