{
  "name": "neksoft-connected-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "start": "node server/start.mjs",
    "test:backend": "node --test server/tests/*.test.mjs",
    "backup": "node server/operations.mjs backup",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir server-dist && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "chrome-launcher": "^1.2.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.14",
    "lighthouse": "^12.8.2",
    "lucide-react": "^0.552.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "typescript": "~5.9.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
